{
  "name": "linear-linux",
  "version": "0.3.2",
  "description": "Linux support for linear.app",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build": "npx electron-builder --linux AppImage deb --x64"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agence-appy/linear-linux.git"
  },
  "keywords": [],
  "author": "Agence Appy",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/agence-appy/linear-linux/issues"
  },
  "homepage": "https://github.com/agence-appy/linear-linux#readme",
  "build": {
    "appId": "app.linear.linux",
    "productName": "Linear",
    "files": [
      "main.js",
      "package.json",
      "assets/**/*"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build/icons",
      "desktop": {
        "entry": {
          "StartupWMClass": "linear-linux"
        }
      },
      "maintainer": "Agence Appy",
      "synopsis": "Linear Linux desktop application",
      "description": "A maintained fork of Linear Linux",
      "artifactName": "linear-linux-${version}-${arch}.${ext}"
    },
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ]
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  }
}
